{
  "schema": "fight-animations.action-specs/1",
  "fps": 30,
  "covers": "life, interaction and extra traversal states added to the procedural clip set",
  "verbs": [
    {"id": "bow", "clip": "bow", "frames": 48, "loop": false, "root_motion": false,
     "startup_frames": [0, 12], "hold_frames": [12, 24], "recovery_frames": [24, 48],
     "cancel": "any input after frame 24", "intent": "respect/greeting readable at CCTV distance"},
    {"id": "block", "clip": "block", "frames": 48, "loop": false, "root_motion": false,
     "startup_frames": [0, 8], "active_frames": [8, 24], "recovery_frames": [24, 48],
     "contact_rule": "front-facing hits inside the guard arc are reduced or parried; resolve once per attacker id",
     "cancel": "after frame 24 into slash or dodge"},
    {"id": "dodge", "clip": "dodge", "frames": 36, "loop": false, "root_motion": true,
     "travel": "0.42 m lateral sidestep and return; no net displacement",
     "startup_frames": [0, 6], "invulnerable_frames": [6, 20], "recovery_frames": [20, 36],
     "contact_rule": "attacks whose contact point misses the displaced capsule are rejected",
     "cancel": "none before frame 20"},
    {"id": "jump", "clip": "jump", "frames": 54, "loop": false, "root_motion": true,
     "travel": "0.28 m forward, 0.44 m apex", "startup_frames": [0, 6],
     "airborne_frames": [10, 26], "landing_frames": [26, 32], "recovery_frames": [32, 54],
     "contact_rule": "grounded-only attacks cannot hit during airborne frames",
     "cancel": "attack after frame 32"},
    {"id": "door_open", "clip": "door_open", "frames": 54, "loop": false, "root_motion": true,
     "travel": "0.26 m forward", "reach_frames": [10, 21], "pull_frames": [21, 32],
     "recovery_frames": [32, 54],
     "contact_rule": "door state changes once on frame 21 when the hand is within reach",
     "cancel": "after frame 32"},
    {"id": "interact", "clip": "interact", "frames": 42, "loop": false, "root_motion": false,
     "reach_frames": [10, 20], "hold_frames": [20, 27], "recovery_frames": [27, 42],
     "contact_rule": "nearest interactable within 0.9 m resolves once on frame 20"},
    {"id": "climb", "clip": "climb", "frames": 36, "loop": true, "root_motion": true,
     "travel": "0.35 m vertical per cycle on root", "hand_contacts": "alternating left/right every half cycle",
     "cancel": "any direction input"},
    {"id": "sleep", "clip": "sleep", "frames": 120, "loop": true, "root_motion": false,
     "cancel": "wake on damage or input"},
    {"id": "drink", "clip": "drink", "frames": 54, "loop": false, "root_motion": false,
     "sip_frames": [8, 17], "consume_on_frame": 17, "recovery_frames": [29, 54]},
    {"id": "eat", "clip": "eat", "frames": 66, "loop": false, "root_motion": false,
     "bite_frames": [6, 10, 15, 19], "consume_on_frames": [10, 19],
     "recovery_frames": [23, 66]},
    {"id": "cook", "clip": "cook", "frames": 60, "loop": true, "root_motion": false,
     "stir_cycle_frames": 60, "progress_tick_frames": [15, 30, 45, 60]},
    {"id": "craft", "clip": "craft", "frames": 48, "loop": true, "root_motion": false,
     "strike_on_frame": 24, "progress_tick_frames": [24, 48]},
    {"id": "run", "clip_pattern": "run_{f,fl,l,bl,b,br,r,fr}", "frames": 20,
     "loop": true, "root_motion": true, "measured_speed_mps": 1.46,
     "cancel": "any attack or hit"},
    {"id": "sprint", "clip_pattern": "sprint_{f,fl,l,bl,b,br,r,fr}", "frames": 16,
     "loop": true, "root_motion": true, "measured_speed_mps": 1.98,
     "cancel": "any attack or hit"}
  ],
  "deterministic_tests": [
    "bow: no root motion and returns to the rest pose by frame 48",
    "block: guard is up on frames 8-24 and only front-facing contacts are reduced",
    "dodge: lateral travel peaks at frame 6 and returns to origin by frame 36",
    "jump: no grounded hit between frames 10 and 26; lands below 2 cm penetration",
    "door_open: opens exactly once on frame 21 and stays open",
    "drink/eat: consume events fire only on the listed frames",
    "cook/craft: progress ticks repeat once per loop with no seam pop",
    "run/sprint: all eight directions travel on root within 25 degrees of their suffix axis"
  ]
}
