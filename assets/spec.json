{
  "project": "starfall",
  "spec_source": "docs/ART_DIRECTION.md + docs/ENGINE.md (flat-shaded low-poly, 1u = 1 tile = 1m)",
  "engine": "babylon",
  "axes": {
    "blender_up": "Z",
    "blender_front": "-Y",
    "gltf_front": "+Z",
    "export_yup": true
  },
  "units_m": 1.0,
  "reference_dims_m": {
    "human": 1.55,
    "eye": 1.45,
    "door": [
      0.9,
      2.0
    ],
    "floor_to_floor": 2.5,
    "curb": 0.1,
    "street_lamp": 3.0,
    "camera_mount": 3.0
  },
  "paths": {
    "export": "export",
    "placeholder": "export/_placeholder",
    "src": "src",
    "tex": "src/tex",
    "review": "review",
    "manifest": "manifest.json",
    "licenses": "LICENSES.md",
    "materials": "materials.json",
    "materials_dir": "materials"
  },
  "naming": {
    "id_regex": "^[a-z][a-z0-9_]*[a-z0-9]$",
    "node_regex": "^[a-z][a-z0-9_]*$",
    "material_regex": "^.*$",
    "texture_regex": "^.*$",
    "lod_suffix": "_lod{n}",
    "col_suffix": "_col",
    "broken_suffix": "_broken",
    "texture_note": "t_<asset id>_<slot> for unique sets; t_<library name>_<slot> for library materials"
  },
  "categories": {
    "env": {
      "prefix": "env_",
      "export_dir": "env",
      "src_dir": "env",
      "pivot": "bottom_left_back",
      "budget_class": "kit",
      "density_class": "kit",
      "lightmap_uv": true,
      "colliders": [
        "mesh"
      ],
      "grid": {
        "major": 1.0,
        "minor": 0.25
      },
      "required_props": []
    },
    "state": {
      "prefix": "state_",
      "export_dir": "state",
      "src_dir": "props",
      "pivot": "bottom_center",
      "budget_class": "prop",
      "density_class": "prop",
      "lightmap_uv": false,
      "colliders": [
        "mesh",
        "box",
        "convex"
      ],
      "required_props": [
        "ig_attach"
      ]
    },
    "prop": {
      "prefix": "prop_",
      "export_dir": "props",
      "src_dir": "props",
      "pivot": "bottom_center",
      "budget_class": "prop",
      "density_class": "prop",
      "lightmap_uv": true,
      "colliders": [
        "mesh",
        "box",
        "convex"
      ],
      "required_props": []
    },
    "phys": {
      "prefix": "phys_",
      "export_dir": "phys",
      "src_dir": "props",
      "pivot": "center_of_mass",
      "budget_class": "prop",
      "density_class": "prop",
      "lightmap_uv": false,
      "colliders": [
        "convex",
        "box"
      ],
      "required_props": [
        "ig_mass",
        "ig_material"
      ]
    },
    "wpn": {
      "prefix": "wpn_",
      "export_dir": "props",
      "src_dir": "props",
      "pivot": "custom",
      "budget_class": "hero",
      "density_class": "prop",
      "lightmap_uv": false,
      "colliders": [],
      "required_props": []
    },
    "char": {
      "prefix": "char_",
      "export_dir": "char",
      "src_dir": "char",
      "pivot": "bottom_center",
      "budget_class": "char_body",
      "density_class": "char_body",
      "lightmap_uv": false,
      "colliders": [],
      "required_props": []
    },
    "dec": {
      "prefix": "dec_",
      "export_dir": "dec",
      "src_dir": "env",
      "pivot": "bottom_center",
      "budget_class": "decal",
      "density_class": "prop",
      "lightmap_uv": false,
      "colliders": [],
      "required_props": []
    }
  },
  "budgets": {
    "kit": 500,
    "prop": 500,
    "hero": 1500,
    "vehicle": 1000,
    "char_body": 1500,
    "char_head": 800,
    "decal": 200
  },
  "texel_density": {
    "kit": 256,
    "prop": 512,
    "hero": 512,
    "char_body": 512,
    "char_head": 1024,
    "roof": 128,
    "distance": 128
  },
  "texel_density_tolerance": 0.35,
  "lod": {
    "min_tris": 10000,
    "ratios": [
      1.0,
      0.4,
      0.15
    ],
    "ratio_tolerance": 0.12
  },
  "collision": {
    "prop": "ig_collider",
    "kinds": [
      "box",
      "convex",
      "mesh"
    ],
    "max_convex_verts": 64
  },
  "uv": {
    "uv0": "UVMap",
    "uv1": "Lightmap",
    "lightmap_res": 1024,
    "lightmap_padding_px": 4
  },
  "textures": {
    "max_px": 2048,
    "power_of_two": true,
    "format": "png",
    "normal_convention": "opengl",
    "embed": true,
    "loose_copy": true
  },
  "materials": {
    "workflow": "metallic_roughness",
    "max_kit_material_sets": 64,
    "alpha": {
      "MASK": [
        "foliage",
        "fence",
        "wire",
        "grate",
        "hedge",
        "weed",
        "leaf"
      ],
      "BLEND": [
        "glass",
        "decal",
        "dec_"
      ]
    },
    "albedo_srgb_min": 0.02,
    "albedo_srgb_max": 0.94,
    "albedo_clip_fraction_max": 0.005,
    "roughness_min_mean": 0.45
  },
  "palette": {
    "swatches": {
      "tunic": "#FF8C26",
      "skin": "#EAB88C",
      "hair": "#4A2E1A",
      "leather": "#592F1A",
      "pants": "#2E3440",
      "steel": "#C8D0D8",
      "gold": "#D9A62E",
      "arcane": "#6B3FA0",
      "leaf": "#3A7A33",
      "grass": "#5B8C3A",
      "sand": "#D9B46A",
      "snow": "#E8F0FA",
      "water": "#3A7CA5",
      "fire": "#FF6A2A",
      "enemy": "#C0392B",
      "charcoal": "#1A1A1A"
    },
    "max_saturation": 1.0,
    "accent_rules": []
  },
  "physics": {
    "materials": [
      "wood",
      "metal",
      "concrete",
      "glass",
      "cloth",
      "plastic",
      "cardboard"
    ],
    "density_kg_m3": {
      "wood": 450,
      "metal": 7800,
      "concrete": 2300,
      "glass": 2500,
      "cloth": 300,
      "plastic": 950,
      "cardboard": 200
    },
    "mass_guide_kg": {
      "bottle": 0.5,
      "chair": 6,
      "crate_wood": 15,
      "oil_drum": 40,
      "filing_cabinet": 60,
      "dumpster": 300
    }
  },
  "prop_schema": {
    "ig_mass": "number>0",
    "ig_material": "enum:physics.materials",
    "ig_health": "number>0",
    "ig_flammable": "bool",
    "ig_explosive": "bool",
    "ig_hinge": "vec3",
    "ig_hinge_axis": "vec3",
    "ig_attach": "enum:ground,wall,pole,ceiling",
    "ig_footprint": "vec2",
    "ig_collider": "enum:collision.kinds"
  },
  "coordinate_props": [
    "ig_hinge",
    "ig_hinge_axis"
  ],
  "sockets": {
    "prefix": "socket_",
    "forward": "blender_local_+Y (glTF local -Z)",
    "required": {
      "state_camera_": [
        "socket_view"
      ],
      "state_loudspeaker": [
        "socket_speaker"
      ]
    }
  },
  "states": {
    "state_camera_": [
      "_intact",
      "_sabotaged"
    ]
  },
  "skeleton": {
    "ref": "src/char/skeleton_ref.blend",
    "max_bones": 72,
    "max_influences": 4,
    "bones": [
      "root",
      "hips",
      "spine",
      "chest",
      "upper_chest",
      "neck",
      "head",
      "eye_l",
      "eye_r",
      "shoulder_l",
      "shoulder_r",
      "upper_arm_l",
      "upper_arm_r",
      "lower_arm_l",
      "lower_arm_r",
      "hand_l",
      "hand_r",
      "thumb_01_l",
      "thumb_02_l",
      "thumb_03_l",
      "index_01_l",
      "index_02_l",
      "index_03_l",
      "middle_01_l",
      "middle_02_l",
      "middle_03_l",
      "ring_01_l",
      "ring_02_l",
      "ring_03_l",
      "pinky_01_l",
      "pinky_02_l",
      "pinky_03_l",
      "thumb_01_r",
      "thumb_02_r",
      "thumb_03_r",
      "index_01_r",
      "index_02_r",
      "index_03_r",
      "middle_01_r",
      "middle_02_r",
      "middle_03_r",
      "ring_01_r",
      "ring_02_r",
      "ring_03_r",
      "pinky_01_r",
      "pinky_02_r",
      "pinky_03_r",
      "upper_leg_l",
      "upper_leg_r",
      "lower_leg_l",
      "lower_leg_r",
      "foot_l",
      "foot_r",
      "toes_l",
      "toes_r",
      "attach_hand_r",
      "attach_hand_l",
      "attach_back",
      "attach_hip_r",
      "attach_head"
    ],
    "blendshapes_required_head": [
      "jawOpen",
      "eyeBlinkLeft",
      "eyeBlinkRight",
      "browInnerUp",
      "browDownLeft",
      "browDownRight",
      "mouthFrownLeft",
      "mouthFrownRight",
      "eyeWideLeft",
      "eyeWideRight",
      "mouthPucker",
      "mouthSmileLeft",
      "mouthSmileRight",
      "viseme_aa",
      "viseme_ee",
      "viseme_oh",
      "viseme_ff",
      "viseme_mm"
    ]
  },
  "review": {
    "background": "#8E9496",
    "ground": "#5E605C",
    "fog": {
      "color": "#8E9496",
      "start": 25,
      "end": 140
    },
    "exposure": 1.0,
    "hdri": null,
    "mannequin_height": 1.75,
    "views": [
      "front",
      "three_quarter",
      "eye",
      "iso",
      "feed",
      "lods",
      "collision",
      "uv_density"
    ],
    "feed": {
      "label": "CAM",
      "res": [
        320,
        240
      ],
      "tint": "#9FC7A8",
      "scanlines": true,
      "mount_height": 3.5,
      "distance": 9
    },
    "iso": {
      "elevation_deg": 50,
      "azimuth_deg": 45
    }
  },
  "animation": {
    "fps": 30,
    "export_dir": "animations",
    "src_dir": "src/anim",
    "owner": "animation",
    "spec_source": "docs/ART_DIRECTION.md + game-animation conventions; video->GVHMR->Mixamo path unavailable (no estimator env, checkpoints, Mixamo FBX or plate)",
    "target_mesh": "models/player.glb",
    "rig_kind": "object empties over the 19 unskinned player parts (no armature in this asset)",
    "position_tracks": ["root", "hips"],
    "unkeyed_bones": ["eye_l", "eye_r", "attach_hand_r"],
    "allow_scale_keys": false,
    "naming": {
      "clip_regex": "^[a-z][a-z0-9_]*$",
      "loop_clips": ["idle", "walk_f", "walk_fl", "walk_l", "walk_bl", "walk_b", "walk_br", "walk_r", "walk_fr"],
      "direction_codes": ["f", "fl", "l", "bl", "b", "br", "r", "fr"]
    },
    "directions_gltf": {
      "f": [0, 1], "fl": [0.7071, 0.7071], "l": [1, 0], "bl": [0.7071, -0.7071],
      "b": [0, -1], "br": [-0.7071, -0.7071], "r": [-1, 0], "fr": [-0.7071, 0.7071]
    },
    "root_motion": {
      "travel_on": "root",
      "hips": "vertical bob only",
      "in_place": ["idle"],
      "decision": "walks carry 1.09 m/s on root; slash/hit/death carry their one-shot step on root; no scale keys"
    },
    "engine": {
      "bone_frames": "world_aligned object tracks",
      "loop_convention": "frame N duplicates frame 0 in root-relative pose; root translation advances one stride",
      "samplers": "LINEAR"
    },
    "durations_s": {"idle": 4.033, "walk_cycle": 0.8, "attack_sword_slash": 1.4, "hit": 1.0, "death": 1.8},
    "thresholds": {
      "loop_seam_position_cm": [0.5, 2.0],
      "loop_seam_velocity_mps": [0.3, 0.8],
      "root_velocity_mps": [0.1, 0.3],
      "foot_slide_cm": [2.0, 5.0],
      "ground_penetration_cm": [1.0, 3.0],
      "end_settled_mps": [0.05, 0.15]
    },
    "clip_manifest": "animations/manifest.json",
    "action_spec": "animations/action_specs/combat.json"
  },
  "manifest_fields": [
    "id",
    "path",
    "category",
    "tier",
    "status",
    "source",
    "license",
    "notes"
  ]
}